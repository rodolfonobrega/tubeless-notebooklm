{
  "manifest_version": 3,
  "name": "TubeLess para NotebookLM",
  "version": "1.4.1",
  "description": "Pesquise vídeos e adicione os selecionados ao seu notebook.",
  "minimum_chrome_version": "116",
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "permissions": ["storage", "tabs", "sidePanel", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://www.googleapis.com/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://consent.youtube.com/*",
    "https://consent.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://raw.githubusercontent.com/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Abrir TubeLess", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
      "js": ["content/notebook.js"],
      "run_at": "document_idle"
    }
  ]
}
